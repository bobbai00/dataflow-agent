# agent-service's webserver configuration
PORT=3001
API_PREFIX=/api

# ERROR | WARN | INFO | DEBUG
TEXERA_SERVICE_LOG_LEVEL=INFO

# Human-readable dev logs via pino-pretty.
LOG_PRETTY=true

# The LLM gateway (POST /api/chat/<route>, GET /api/models) served by the
# access-control-service. The agent sends the delegating user's Texera JWT;
# the provider keys live behind the gateway.
LLM_ENDPOINT=http://localhost:9096

# Texera backend services
TEXERA_DASHBOARD_SERVICE_ENDPOINT=http://localhost:8080
TEXERA_FILE_SERVICE_ENDPOINT=http://localhost:9092
TEXERA_COMPUTING_UNIT_ENDPOINT=http://localhost:8888
WORKFLOW_EXECUTION_SERVICE_ENDPOINT=http://localhost:8085
# Where every agent's turns, steps, versions, executions and results are
# recorded as they happen (one SQLite database for all agents). Default:
# logs/agent-service/traces.db at the repo root; "off" disables the store.
# AGENT_TRACE_DB=../logs/agent-service/traces.db
