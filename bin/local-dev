    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for workflow-compiling-service"
    if ! wait_for_http "workflow-compiling-service" "http://localhost:${WORKFLOW_COMPILING_SERVICE_PORT}/api/healthcheck" 120; then
        printf 'workflow-compiling-service log: %s\n' "$WORKFLOW_COMPILING_SERVICE_LOG_FILE" >&2
        return 1
    fi

    workflow_compiling_listener_pid="$(port_pid "$WORKFLOW_COMPILING_SERVICE_PORT")"
    if [[ -z "$workflow_compiling_listener_pid" ]]; then
        err "workflow-compiling-service reported ready but no process is listening on port $WORKFLOW_COMPILING_SERVICE_PORT"
        printf 'workflow-compiling-service log: %s\n' "$WORKFLOW_COMPILING_SERVICE_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$workflow_compiling_listener_pid" >"$WORKFLOW_COMPILING_SERVICE_PID_FILE"
}

