start_workflow_compiling_service() {
    local python
    local workflow_compiling_listener_pid

    python="$(python_bin)"
    if [[ -z "$python" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    ensure_workflow_compiling_service_distribution

    log "starting workflow-compiling-service"
    TEXERA_HOME="$REPO_ROOT" \
      STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
      STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
      STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
      WORKFLOW_COMPILING_SERVICE_LAUNCHER="$WORKFLOW_COMPILING_SERVICE_LAUNCHER" \
      WORKFLOW_COMPILING_SERVICE_LOG_FILE="$WORKFLOW_COMPILING_SERVICE_LOG_FILE" \
      "$python" <<'PY' >"$WORKFLOW_COMPILING_SERVICE_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["WORKFLOW_COMPILING_SERVICE_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    [os.environ["WORKFLOW_COMPILING_SERVICE_LAUNCHER"]],
