usage() {
    cat >&2 <<EOF
Usage:
  bin/local-dev start
  bin/local-dev stop

Starts/stops the local Bobflow infrastructure stack:
  postgres :$POSTGRES_PORT
  minio    :$MINIO_PORT
  lakefs   :$LAKEFS_PORT
  litellm  :$LITELLM_PORT
  config   :$CONFIG_SERVICE_PORT
  access   :$ACCESS_CONTROL_PORT
  file     :$FILE_SERVICE_PORT
  compile  :$WORKFLOW_COMPILING_SERVICE_PORT
  compute  :$COMPUTING_UNIT_MANAGING_PORT
  texera   :$TEXERA_WEB_PORT
  master   :$COMPUTING_UNIT_MASTER_PORT
  agent    :$AGENT_SERVICE_PORT
  rtc      :$RTC_PORT
  frontend :$FRONTEND_PORT
EOF
}

log() {
    printf '%s\n' "$*"
}

err() {
    printf 'error: %s\n' "$*" >&2
}

compose() {
    docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" "$@"
}

require_command() {
    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        err "required command not found: $cmd"
        exit 1
    fi
}

port_pid() {
    lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1 || true
}

require_free_ports() {
    local occupied=()
    local port pid process

    for port in "$POSTGRES_PORT" "$MINIO_PORT" "$LAKEFS_PORT" "$LITELLM_PORT" "$CONFIG_SERVICE_PORT" "$ACCESS_CONTROL_PORT" "$FILE_SERVICE_PORT" "$WORKFLOW_COMPILING_SERVICE_PORT" "$COMPUTING_UNIT_MANAGING_PORT" "$TEXERA_WEB_PORT" "$COMPUTING_UNIT_MASTER_PORT" "$AGENT_SERVICE_PORT" "$RTC_PORT" "$FRONTEND_PORT"; do
        pid="$(port_pid "$port")"
        if [[ -n "$pid" ]]; then
            process="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
            occupied+=(":$port pid=$pid ${process:-unknown}")
        fi
    done

    if (( ${#occupied[@]} > 0 )); then
        err "refusing to start because required default ports are already occupied"
        printf '  %s\n' "${occupied[@]}" >&2
        printf 'Stop the process using those ports, or run `bin/local-dev stop` if this stack is already running.\n' >&2
        exit 1
    fi
}

require_anthropic_key() {
    if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
        err "ANTHROPIC_API_KEY must be set to a non-empty value before starting"
        printf 'For local debugging, you can run: ANTHROPIC_API_KEY=dummy bin/local-dev start\n' >&2
        exit 1
    fi
}

wait_for_postgres() {
    local timeout="${1:-90}"
    local i=0

    while (( i < timeout )); do
        if compose exec -T postgres pg_isready -U texera -d texera_db -q >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done

    err "postgres did not become ready within ${timeout}s"
    return 1
}

wait_for_http() {
    local name="$1"
    local url="$2"
    local timeout="${3:-90}"
    local i=0

    while (( i < timeout )); do
        if curl -fsS "$url" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done

    err "$name did not become healthy at $url within ${timeout}s"
    return 1
}

wait_for_port() {
    local name="$1"
    local port="$2"
    local timeout="${3:-90}"
    local i=0

    while (( i < timeout )); do
        if [[ -n "$(port_pid "$port")" ]]; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done

    err "$name did not listen on port $port within ${timeout}s"
    return 1
}

psql_value() {
    compose exec -T postgres psql -U texera -d postgres -tAc "$1" 2>/dev/null | tr -d '[:space:]'
}

ensure_database_file() {
    local database="$1"
    local sql_file="$2"

    if [[ "$(psql_value "SELECT 1 FROM pg_database WHERE datname='${database}'")" == "1" ]]; then
        return 0
    fi

    log "postgres: applying $sql_file"
    compose exec -T postgres psql -U texera -f "/docker-entrypoint-initdb.d/$sql_file" >/dev/null
}

ensure_texera_schema() {
    local has_user_table

    ensure_database_file "texera_db" "texera_ddl.sql"

    has_user_table="$(
        compose exec -T postgres psql -U texera -d texera_db -tAc \
            "SELECT to_regclass('texera_db.\"user\"') IS NOT NULL" 2>/dev/null | tr -d '[:space:]'
    )"

    if [[ "$has_user_table" != "t" ]]; then
        log "postgres: applying texera_ddl.sql"
        compose exec -T postgres psql -U texera -f /docker-entrypoint-initdb.d/texera_ddl.sql >/dev/null
    fi
}

ensure_postgres_databases() {
    ensure_texera_schema
    ensure_database_file "texera_lakefs" "texera_lakefs.sql"
    ensure_database_file "texera_iceberg_catalog" "iceberg_postgres_catalog.sql"
}

verify_postgres_access() {
    local db
    db="$(compose exec -T postgres psql -U texera -d texera_db -tAc 'SELECT current_database()' 2>/dev/null | tr -d '[:space:]')"
    if [[ "$db" != "texera_db" ]]; then
        err "postgres verification failed"
        return 1
    fi
}

config_service_zip() {
    if [[ -d "$REPO_ROOT/config-service/target/universal" ]]; then
        find "$REPO_ROOT/config-service/target/universal" -maxdepth 1 -type f -name 'config-service-*.zip' | sort | tail -1
    fi
}

config_service_launcher() {
    if [[ -d "$STATE_DIR" ]]; then
        find "$STATE_DIR" -maxdepth 3 -path '*/bin/config-service' -type f -perm -111 | sort | head -1
    fi
}

ensure_config_service_distribution() {
    local launcher
    local zip

    launcher="$(config_service_launcher)"
    if [[ -n "$launcher" && -x "$launcher" ]]; then
        CONFIG_SERVICE_LAUNCHER="$launcher"
        return 0
    fi

    zip="$(config_service_zip)"
    if [[ -z "$zip" ]]; then
        require_command sbt
        log "config-service: building distribution"
        (
            cd "$REPO_ROOT"
            STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
              STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
              STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
              sbt "ConfigService/dist"
        )
        zip="$(config_service_zip)"
    fi

    if [[ -z "$zip" ]]; then
        err "config-service distribution zip was not produced"
        return 1
    fi

    require_command unzip
    log "config-service: extracting distribution"
    rm -rf "$STATE_DIR"/config-service-*
    unzip -q -o "$zip" -d "$STATE_DIR"

    launcher="$(config_service_launcher)"
    if [[ -z "$launcher" || ! -x "$launcher" ]]; then
        err "config-service launcher was not found after extracting $zip"
        return 1
    fi

    CONFIG_SERVICE_LAUNCHER="$launcher"
}

python_bin() {
    if [[ -x "$PYTHON_EXECUTABLE" ]]; then
        printf '%s\n' "$PYTHON_EXECUTABLE"
    fi
}

python_setup_command() {
    printf '%s\n' 'uv sync --locked --python 3.12 --extra dev --extra kramabench --no-install-project'
}

verify_python_environment() {
    local python
    local uv_check_output

    python="$(python_bin)"
    if [[ -z "$python" ]]; then
        err "Python environment not found at $PYTHON_ENV_DIR"
        printf 'Create it from the repository root with:\n  %s\n' "$(python_setup_command)" >&2
        exit 1
    fi

    if ! "$python" <<'PY'
import importlib
import sys

if sys.version_info[:2] != (3, 12):
    raise SystemExit(
        f"expected Python 3.12, found {sys.version.split()[0]} at {sys.executable}"
    )

if sys.prefix == sys.base_prefix:
    raise SystemExit(f"expected a virtual environment, found system Python at {sys.executable}")

required_modules = (
    "betterproto",
    "loguru",
    "numpy",
    "overrides",
    "pandas",
    "pyarrow",
    "requests",
)
missing_modules = []
for module in required_modules:
    try:
        importlib.import_module(module)
    except ImportError:
        missing_modules.append(module)

if missing_modules:
    raise SystemExit("missing required Python modules: " + ", ".join(missing_modules))
PY
    then
        err "Python environment validation failed"
        printf 'Rebuild it from the repository root with:\n  %s\n' "$(python_setup_command)" >&2
        exit 1
    fi

    if ! uv_check_output="$(
        cd "$REPO_ROOT"
        uv sync --check --locked --python "$python" --extra dev --extra kramabench --no-install-project 2>&1
    )"; then
        printf '%s\n' "$uv_check_output" >&2
        err "Python environment is not synchronized with uv.lock"
        printf 'Synchronize it from the repository root with:\n  %s\n' "$(python_setup_command)" >&2
        exit 1
    fi

    log "python: $($python -c 'import platform; print(platform.python_version())') ($python)"
}

start_config_service() {
    local python
    local config_listener_pid

    python="$(python_bin)"
    if [[ -z "$python" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    ensure_config_service_distribution

    log "starting config-service"
    TEXERA_HOME="$REPO_ROOT" \
      STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
      STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
      STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
      CONFIG_SERVICE_LAUNCHER="$CONFIG_SERVICE_LAUNCHER" \
      CONFIG_SERVICE_LOG_FILE="$CONFIG_SERVICE_LOG_FILE" \
      "$python" <<'PY' >"$CONFIG_SERVICE_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["CONFIG_SERVICE_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    [os.environ["CONFIG_SERVICE_LAUNCHER"]],
    cwd=os.environ["TEXERA_HOME"],
    env=os.environ.copy(),
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for config-service"
    if ! wait_for_http "config-service" "http://localhost:${CONFIG_SERVICE_PORT}/api/healthcheck" 120; then
        printf 'config-service log: %s\n' "$CONFIG_SERVICE_LOG_FILE" >&2
        return 1
    fi

    config_listener_pid="$(port_pid "$CONFIG_SERVICE_PORT")"
    if [[ -z "$config_listener_pid" ]]; then
        err "config-service reported ready but no process is listening on port $CONFIG_SERVICE_PORT"
        printf 'config-service log: %s\n' "$CONFIG_SERVICE_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$config_listener_pid" >"$CONFIG_SERVICE_PID_FILE"

    if ! curl -fsS "http://localhost:${CONFIG_SERVICE_PORT}/api/config/gui" >/dev/null; then
        err "config-service did not serve /api/config/gui"
        printf 'config-service log: %s\n' "$CONFIG_SERVICE_LOG_FILE" >&2
        return 1
    fi
    if ! curl -fsS "http://localhost:${CONFIG_SERVICE_PORT}/api/config/user-system" >/dev/null; then
        err "config-service did not serve /api/config/user-system"
        printf 'config-service log: %s\n' "$CONFIG_SERVICE_LOG_FILE" >&2
        return 1
    fi
}

stop_config_service() {
    local pid=""
    local port_pid_value

    if [[ -f "$CONFIG_SERVICE_PID_FILE" ]]; then
        pid="$(cat "$CONFIG_SERVICE_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping config-service"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    port_pid_value="$(port_pid "$CONFIG_SERVICE_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$CONFIG_SERVICE_PID_FILE"
}

