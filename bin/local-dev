start_access_control() {
    local python
    local access_control_listener_pid

    python="$(python_bin)"
    if [[ -z "$python" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    ensure_access_control_distribution

    log "starting access-control-service"
    TEXERA_HOME="$REPO_ROOT" \
      STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
      STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
      STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
      LITELLM_BASE_URL="$LITELLM_BASE_URL" \
      LITELLM_MASTER_KEY="$LITELLM_MASTER_KEY" \
      ACCESS_CONTROL_LAUNCHER="$ACCESS_CONTROL_LAUNCHER" \
      ACCESS_CONTROL_LOG_FILE="$ACCESS_CONTROL_LOG_FILE" \
      "$python" <<'PY' >"$ACCESS_CONTROL_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["ACCESS_CONTROL_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    [os.environ["ACCESS_CONTROL_LAUNCHER"]],
    cwd=os.environ["TEXERA_HOME"],
    env=os.environ.copy(),
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for access-control-service"
    if ! wait_for_http "access-control-service" "http://localhost:${ACCESS_CONTROL_PORT}/api/healthcheck" 120; then
        printf 'access-control-service log: %s\n' "$ACCESS_CONTROL_LOG_FILE" >&2
        return 1
    fi

    access_control_listener_pid="$(port_pid "$ACCESS_CONTROL_PORT")"
    if [[ -z "$access_control_listener_pid" ]]; then
        err "access-control-service reported ready but no process is listening on port $ACCESS_CONTROL_PORT"
        printf 'access-control-service log: %s\n' "$ACCESS_CONTROL_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$access_control_listener_pid" >"$ACCESS_CONTROL_PID_FILE"

    if ! curl -fsS "http://localhost:${ACCESS_CONTROL_PORT}/api/models" >/dev/null; then
        err "access-control-service could not route /api/models to LiteLLM at $LITELLM_BASE_URL"
        printf 'access-control-service log: %s\n' "$ACCESS_CONTROL_LOG_FILE" >&2
        return 1
    fi
}

stop_access_control() {
    local pid=""
    local port_pid_value

    if [[ -f "$ACCESS_CONTROL_PID_FILE" ]]; then
        pid="$(cat "$ACCESS_CONTROL_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping access-control-service"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    port_pid_value="$(port_pid "$ACCESS_CONTROL_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$ACCESS_CONTROL_PID_FILE"
}

