        log "file-service: building distribution"
        (
            cd "$REPO_ROOT"
            STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
              STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
              STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
              STORAGE_S3_ENDPOINT="$STORAGE_S3_ENDPOINT" \
              STORAGE_S3_AUTH_USERNAME="$STORAGE_S3_AUTH_USERNAME" \
              STORAGE_S3_AUTH_PASSWORD="$STORAGE_S3_AUTH_PASSWORD" \
              STORAGE_S3_REGION="$STORAGE_S3_REGION" \
              STORAGE_LAKEFS_ENDPOINT="$STORAGE_LAKEFS_ENDPOINT" \
              STORAGE_LAKEFS_AUTH_USERNAME="$STORAGE_LAKEFS_AUTH_USERNAME" \
              STORAGE_LAKEFS_AUTH_PASSWORD="$STORAGE_LAKEFS_AUTH_PASSWORD" \
              STORAGE_LAKEFS_AUTH_API_SECRET="$STORAGE_LAKEFS_AUTH_API_SECRET" \
              STORAGE_LAKEFS_BLOCK_STORAGE_TYPE="$STORAGE_LAKEFS_BLOCK_STORAGE_TYPE" \
              STORAGE_LAKEFS_BLOCK_STORAGE_BUCKET_NAME="$STORAGE_LAKEFS_BLOCK_STORAGE_BUCKET_NAME" \
              sbt "FileService/dist"
        )
        zip="$(file_service_zip)"
    fi

    if [[ -z "$zip" ]]; then
        err "file-service distribution zip was not produced"
        return 1
    fi

    require_command unzip
    log "file-service: extracting distribution"
    rm -rf "$STATE_DIR"/file-service-*
    unzip -q -o "$zip" -d "$STATE_DIR"

    launcher="$(file_service_launcher)"
    if [[ -z "$launcher" || ! -x "$launcher" ]]; then
        err "file-service launcher was not found after extracting $zip"
        return 1
    fi

    FILE_SERVICE_LAUNCHER="$launcher"
}

start_file_service() {
    local python
    local file_service_listener_pid

    python="$(python_bin)"
    if [[ -z "$python" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    ensure_file_service_distribution

    log "starting file-service"
    TEXERA_HOME="$REPO_ROOT" \
      STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
      STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
      STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
      STORAGE_S3_ENDPOINT="$STORAGE_S3_ENDPOINT" \
      STORAGE_S3_AUTH_USERNAME="$STORAGE_S3_AUTH_USERNAME" \
      STORAGE_S3_AUTH_PASSWORD="$STORAGE_S3_AUTH_PASSWORD" \
      STORAGE_S3_REGION="$STORAGE_S3_REGION" \
      STORAGE_LAKEFS_ENDPOINT="$STORAGE_LAKEFS_ENDPOINT" \
      STORAGE_LAKEFS_AUTH_USERNAME="$STORAGE_LAKEFS_AUTH_USERNAME" \
      STORAGE_LAKEFS_AUTH_PASSWORD="$STORAGE_LAKEFS_AUTH_PASSWORD" \
      STORAGE_LAKEFS_AUTH_API_SECRET="$STORAGE_LAKEFS_AUTH_API_SECRET" \
      STORAGE_LAKEFS_BLOCK_STORAGE_TYPE="$STORAGE_LAKEFS_BLOCK_STORAGE_TYPE" \
      STORAGE_LAKEFS_BLOCK_STORAGE_BUCKET_NAME="$STORAGE_LAKEFS_BLOCK_STORAGE_BUCKET_NAME" \
      FILE_SERVICE_LAUNCHER="$FILE_SERVICE_LAUNCHER" \
      FILE_SERVICE_LOG_FILE="$FILE_SERVICE_LOG_FILE" \
      "$python" <<'PY' >"$FILE_SERVICE_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["FILE_SERVICE_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    [os.environ["FILE_SERVICE_LAUNCHER"]],
    cwd=os.environ["TEXERA_HOME"],
    env=os.environ.copy(),
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for file-service"
    if ! wait_for_http "file-service" "http://localhost:${FILE_SERVICE_PORT}/api/healthcheck" 120; then
        printf 'file-service log: %s\n' "$FILE_SERVICE_LOG_FILE" >&2
        return 1
    fi

    file_service_listener_pid="$(port_pid "$FILE_SERVICE_PORT")"
    if [[ -z "$file_service_listener_pid" ]]; then
        err "file-service reported ready but no process is listening on port $FILE_SERVICE_PORT"
        printf 'file-service log: %s\n' "$FILE_SERVICE_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$file_service_listener_pid" >"$FILE_SERVICE_PID_FILE"
}

stop_file_service() {
    local pid=""
    local port_pid_value

    if [[ -f "$FILE_SERVICE_PID_FILE" ]]; then
        pid="$(cat "$FILE_SERVICE_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping file-service"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    port_pid_value="$(port_pid "$FILE_SERVICE_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$FILE_SERVICE_PID_FILE"
}

