log = open(os.environ["TEXERA_WEB_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    [os.environ["TEXERA_WEB_LAUNCHER"]],
    cwd=os.path.join(os.environ["TEXERA_HOME"], "amber"),
    env=os.environ.copy(),
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for texera-web"
    if ! wait_for_http "texera-web" "http://localhost:${TEXERA_WEB_PORT}/api/healthcheck" 180; then
        printf 'texera-web log: %s\n' "$TEXERA_WEB_LOG_FILE" >&2
        return 1
    fi

    texera_web_listener_pid="$(port_pid "$TEXERA_WEB_PORT")"
    if [[ -z "$texera_web_listener_pid" ]]; then
        err "texera-web reported ready but no process is listening on port $TEXERA_WEB_PORT"
        printf 'texera-web log: %s\n' "$TEXERA_WEB_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$texera_web_listener_pid" >"$TEXERA_WEB_PID_FILE"
}

stop_texera_web() {
    local pid=""
    local port_pid_value

    if [[ -f "$TEXERA_WEB_PID_FILE" ]]; then
        pid="$(cat "$TEXERA_WEB_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping texera-web"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    port_pid_value="$(port_pid "$TEXERA_WEB_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$TEXERA_WEB_PID_FILE"
}

computing_unit_master_launcher() {
    if [[ -d "$REPO_ROOT/amber/target" ]]; then
        find "$REPO_ROOT/amber/target" -maxdepth 3 -path '*/bin/computing-unit-master' -type f -perm -111 | sort | head -1
    fi
}

ensure_computing_unit_master_distribution() {
    local launcher

    ensure_texera_web_distribution

    launcher="$(computing_unit_master_launcher)"
    if [[ -z "$launcher" || ! -x "$launcher" ]]; then
        err "computing-unit-master launcher was not found in the Amber distribution"
        return 1
    fi

    COMPUTING_UNIT_MASTER_LAUNCHER="$launcher"
}

start_computing_unit_master() {
    local python
    local computing_unit_master_listener_pid
    local udf_python_path

    python="$(python_bin)"
    if [[ -z "$python" ]]; then
        err "required command not found: python3"
        exit 1
    fi
    udf_python_path="$(python_bin)"

    mkdir -p "$STATE_DIR"
    ensure_computing_unit_master_distribution

    log "starting computing-unit-master"
    TEXERA_HOME="$REPO_ROOT" \
      STORAGE_JDBC_URL="$STORAGE_JDBC_URL" \
      STORAGE_JDBC_USERNAME="$STORAGE_JDBC_USERNAME" \
      STORAGE_JDBC_PASSWORD="$STORAGE_JDBC_PASSWORD" \
      STORAGE_S3_ENDPOINT="$STORAGE_S3_ENDPOINT" \
      STORAGE_S3_AUTH_USERNAME="$STORAGE_S3_AUTH_USERNAME" \
      STORAGE_S3_AUTH_PASSWORD="$STORAGE_S3_AUTH_PASSWORD" \
      STORAGE_S3_REGION="$STORAGE_S3_REGION" \
      STORAGE_LAKEFS_ENDPOINT="$STORAGE_LAKEFS_ENDPOINT" \
      STORAGE_LAKEFS_AUTH_USERNAME="$STORAGE_LAKEFS_AUTH_USERNAME" \
      STORAGE_LAKEFS_AUTH_PASSWORD="$STORAGE_LAKEFS_AUTH_PASSWORD" \
      STORAGE_LAKEFS_AUTH_API_SECRET="$STORAGE_LAKEFS_AUTH_API_SECRET" \
      STORAGE_LAKEFS_BLOCK_STORAGE_TYPE="$STORAGE_LAKEFS_BLOCK_STORAGE_TYPE" \
      STORAGE_LAKEFS_BLOCK_STORAGE_BUCKET_NAME="$STORAGE_LAKEFS_BLOCK_STORAGE_BUCKET_NAME" \
      STORAGE_ICEBERG_CATALOG_TYPE="$STORAGE_ICEBERG_CATALOG_TYPE" \
      STORAGE_ICEBERG_CATALOG_POSTGRES_URI_WITHOUT_SCHEME="$STORAGE_ICEBERG_CATALOG_POSTGRES_URI_WITHOUT_SCHEME" \
      STORAGE_ICEBERG_CATALOG_POSTGRES_USERNAME="$STORAGE_ICEBERG_CATALOG_POSTGRES_USERNAME" \
      STORAGE_ICEBERG_CATALOG_POSTGRES_PASSWORD="$STORAGE_ICEBERG_CATALOG_POSTGRES_PASSWORD" \
      TEXERA_DASHBOARD_SERVICE_ENDPOINT="$TEXERA_DASHBOARD_SERVICE_ENDPOINT" \
      WORKFLOW_COMPILING_SERVICE_ENDPOINT="$WORKFLOW_COMPILING_SERVICE_ENDPOINT" \
      WORKFLOW_EXECUTION_SERVICE_ENDPOINT="$WORKFLOW_EXECUTION_SERVICE_ENDPOINT" \
      FILE_SERVICE_GET_PRESIGNED_URL_ENDPOINT="$FILE_SERVICE_GET_PRESIGNED_URL_ENDPOINT" \
      FILE_SERVICE_UPLOAD_ONE_FILE_TO_DATASET_ENDPOINT="$FILE_SERVICE_UPLOAD_ONE_FILE_TO_DATASET_ENDPOINT" \
      USER_SYS_ENABLED="$USER_SYS_ENABLED" \
      SCHEDULE_GENERATOR_ENABLE_COST_BASED_SCHEDULE_GENERATOR="$SCHEDULE_GENERATOR_ENABLE_COST_BASED_SCHEDULE_GENERATOR" \
      MAX_WORKFLOW_WEBSOCKET_REQUEST_PAYLOAD_SIZE_KB="$MAX_WORKFLOW_WEBSOCKET_REQUEST_PAYLOAD_SIZE_KB" \
      UDF_PYTHON_PATH="$udf_python_path" \
      COMPUTING_UNIT_MASTER_LAUNCHER="$COMPUTING_UNIT_MASTER_LAUNCHER" \
      COMPUTING_UNIT_MASTER_LOG_FILE="$COMPUTING_UNIT_MASTER_LOG_FILE" \
      "$python" <<'PY' >"$COMPUTING_UNIT_MASTER_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["COMPUTING_UNIT_MASTER_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    [os.environ["COMPUTING_UNIT_MASTER_LAUNCHER"]],
    cwd=os.path.join(os.environ["TEXERA_HOME"], "amber"),
    env=os.environ.copy(),
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for computing-unit-master"
    if ! wait_for_port "computing-unit-master" "$COMPUTING_UNIT_MASTER_PORT" 120; then
        printf 'computing-unit-master log: %s\n' "$COMPUTING_UNIT_MASTER_LOG_FILE" >&2
        return 1
    fi

    computing_unit_master_listener_pid="$(port_pid "$COMPUTING_UNIT_MASTER_PORT")"
    if [[ -z "$computing_unit_master_listener_pid" ]]; then
        err "computing-unit-master reported ready but no process is listening on port $COMPUTING_UNIT_MASTER_PORT"
        printf 'computing-unit-master log: %s\n' "$COMPUTING_UNIT_MASTER_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$computing_unit_master_listener_pid" >"$COMPUTING_UNIT_MASTER_PID_FILE"
}

stop_computing_unit_master() {
    local pid=""
    local port_pid_value

    if [[ -f "$COMPUTING_UNIT_MASTER_PID_FILE" ]]; then
        pid="$(cat "$COMPUTING_UNIT_MASTER_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping computing-unit-master"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    port_pid_value="$(port_pid "$COMPUTING_UNIT_MASTER_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$COMPUTING_UNIT_MASTER_PID_FILE"
}

ensure_frontend_dependencies() {
    if [[ -d "$REPO_ROOT/frontend/node_modules" ]]; then
        return 0
    fi

    require_command yarn
    log "frontend: installing dependencies"
    (cd "$REPO_ROOT/frontend" && yarn install)
}

ensure_agent_service_dependencies() {
    if [[ -d "$REPO_ROOT/agent-service/node_modules" ]]; then
        return 0
    fi

    require_command bun
    log "agent-service: installing dependencies"
    (cd "$REPO_ROOT/agent-service" && bun install)
}

start_agent_service() {
    local python_bin
    python_bin="$(python_bin)"
    if [[ -z "$python_bin" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    ensure_agent_service_dependencies

    log "starting agent-service"
    AGENT_SERVICE_CWD="$REPO_ROOT/agent-service" \
      AGENT_SERVICE_LOG_FILE="$AGENT_SERVICE_LOG_FILE" \
      PORT="$AGENT_SERVICE_PORT" \
      LLM_API_KEY="$LLM_API_KEY" \
      API_ENDPOINT="$TEXERA_DASHBOARD_SERVICE_ENDPOINT" \
      OPERATOR_METADATA_ENDPOINT="$TEXERA_DASHBOARD_SERVICE_ENDPOINT" \
      MODELS_ENDPOINT="http://localhost:${ACCESS_CONTROL_PORT}" \
      COMPILE_ENDPOINT="$WORKFLOW_COMPILING_SERVICE_ENDPOINT" \
      EXECUTION_ENDPOINT="$WORKFLOW_EXECUTION_SERVICE_ENDPOINT" \
      WS_ENDPOINT="ws://localhost:${COMPUTING_UNIT_MASTER_PORT}" \
      DATASET_ENDPOINT="http://localhost:${FILE_SERVICE_PORT}" \
      COMPUTING_ENDPOINT="http://localhost:${COMPUTING_UNIT_MANAGING_PORT}" \
      CONFIG_ENDPOINT="http://localhost:${CONFIG_SERVICE_PORT}" \
      "$python_bin" <<'PY' >"$AGENT_SERVICE_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["AGENT_SERVICE_LOG_FILE"], "ab", buffering=0)
process = subprocess.Popen(
    ["bun", "run", "dev"],
    cwd=os.environ["AGENT_SERVICE_CWD"],
    env=os.environ.copy(),
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for agent-service"
    if ! wait_for_http "agent-service" "http://localhost:${AGENT_SERVICE_PORT}/health" 120; then
        printf 'agent-service log: %s\n' "$AGENT_SERVICE_LOG_FILE" >&2
        return 1
    fi

    local agent_service_listener_pid
    agent_service_listener_pid="$(port_pid "$AGENT_SERVICE_PORT")"
    if [[ -z "$agent_service_listener_pid" ]]; then
        err "agent-service reported ready but no process is listening on port $AGENT_SERVICE_PORT"
        printf 'agent-service log: %s\n' "$AGENT_SERVICE_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$agent_service_listener_pid" >"$AGENT_SERVICE_PID_FILE"
}

stop_agent_service() {
    local pid=""

    if [[ -f "$AGENT_SERVICE_PID_FILE" ]]; then
        pid="$(cat "$AGENT_SERVICE_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping agent-service"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    local port_pid_value
    port_pid_value="$(port_pid "$AGENT_SERVICE_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$AGENT_SERVICE_PID_FILE"
}

start_rtc_service() {
    local python_bin
    python_bin="$(python_bin)"
    if [[ -z "$python_bin" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR/yjs"
    ensure_frontend_dependencies

    log "starting rtc websocket service"
    RTC_CWD="$REPO_ROOT/frontend" \
      RTC_LOG_FILE="$RTC_LOG_FILE" \
      RTC_PORT="$RTC_PORT" \
      RTC_STATE_DIR="$STATE_DIR/yjs" \
      "$python_bin" <<'PY' >"$RTC_PID_FILE"
import os
import subprocess

stdin = open(os.devnull, "rb")
log = open(os.environ["RTC_LOG_FILE"], "ab", buffering=0)
env = os.environ.copy()
env["HOST"] = "localhost"
env["PORT"] = os.environ["RTC_PORT"]
env["YPERSISTENCE"] = os.environ["RTC_STATE_DIR"]
process = subprocess.Popen(
    ["./node_modules/.bin/y-websocket"],
    cwd=os.environ["RTC_CWD"],
    env=env,
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for rtc websocket service"
    if ! wait_for_port "rtc websocket service" "$RTC_PORT" 60; then
        printf 'rtc websocket service log: %s\n' "$RTC_LOG_FILE" >&2
        return 1
    fi

    local rtc_listener_pid
    rtc_listener_pid="$(port_pid "$RTC_PORT")"
    if [[ -z "$rtc_listener_pid" ]]; then
        err "rtc websocket service reported ready but no process is listening on port $RTC_PORT"
        printf 'rtc websocket service log: %s\n' "$RTC_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$rtc_listener_pid" >"$RTC_PID_FILE"
}

stop_rtc_service() {
    local pid=""

    if [[ -f "$RTC_PID_FILE" ]]; then
        pid="$(cat "$RTC_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping rtc websocket service"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    local port_pid_value
    port_pid_value="$(port_pid "$RTC_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$RTC_PID_FILE"
}

start_frontend() {
    local python_bin
    python_bin="$(python_bin)"
    if [[ -z "$python_bin" ]]; then
        err "required command not found: python3"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    ensure_frontend_dependencies

    log "starting frontend"
    FRONTEND_CWD="$REPO_ROOT/frontend" \
      FRONTEND_LOG_FILE="$FRONTEND_LOG_FILE" \
      FRONTEND_PORT="$FRONTEND_PORT" \
      "$python_bin" <<'PY' >"$FRONTEND_PID_FILE"
import os
import subprocess

cwd = os.environ["FRONTEND_CWD"]
log_path = os.environ["FRONTEND_LOG_FILE"]
port = os.environ["FRONTEND_PORT"]

stdin = open(os.devnull, "rb")
log = open(log_path, "ab", buffering=0)
process = subprocess.Popen(
    ["./node_modules/.bin/ng", "serve", "--host", "localhost", "--port", port],
    cwd=cwd,
    stdin=stdin,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
)
print(process.pid)
PY

    log "waiting for frontend"
    if ! wait_for_http "frontend" "http://localhost:${FRONTEND_PORT}" 180; then
        printf 'frontend log: %s\n' "$FRONTEND_LOG_FILE" >&2
        return 1
    fi

    local frontend_listener_pid
    frontend_listener_pid="$(port_pid "$FRONTEND_PORT")"
    if [[ -z "$frontend_listener_pid" ]]; then
        err "frontend reported ready but no process is listening on port $FRONTEND_PORT"
        printf 'frontend log: %s\n' "$FRONTEND_LOG_FILE" >&2
        return 1
    fi
    printf '%s\n' "$frontend_listener_pid" >"$FRONTEND_PID_FILE"

    sleep 5
    if [[ -z "$(port_pid "$FRONTEND_PORT")" ]]; then
        err "frontend exited after initial startup"
        printf 'frontend log: %s\n' "$FRONTEND_LOG_FILE" >&2
        return 1
    fi
}

stop_frontend() {
    local pid=""

    if [[ -f "$FRONTEND_PID_FILE" ]]; then
        pid="$(cat "$FRONTEND_PID_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        log "stopping frontend"
        kill "$pid" 2>/dev/null || true
        local i=0
        while (( i < 30 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    local port_pid_value
    port_pid_value="$(port_pid "$FRONTEND_PORT")"
    if [[ -n "$port_pid_value" ]]; then
        kill "$port_pid_value" 2>/dev/null || true
    fi

    rm -f "$FRONTEND_PID_FILE"
}

start_stack() {
    require_command docker
    require_command lsof
    require_command ps
    require_command curl
    require_command uv
    verify_python_environment
    require_anthropic_key
    require_free_ports

    if [[ ! -f "$COMPOSE_FILE" ]]; then
        err "compose file not found: $COMPOSE_FILE"
        exit 1
    fi

    log "starting postgres and minio"
    compose up -d postgres minio

    log "waiting for postgres"
    wait_for_postgres 120

    log "ensuring postgres databases"
    ensure_postgres_databases

    log "waiting for minio"
    wait_for_http "minio" "http://localhost:${MINIO_PORT}/minio/health/ready" 120

    log "starting lakefs and litellm"
    compose up -d lakefs litellm

    log "waiting for lakefs"
    wait_for_http "lakefs" "http://localhost:${LAKEFS_PORT}/api/v1/healthcheck" 120

    log "waiting for litellm"
    wait_for_http "litellm" "http://localhost:${LITELLM_PORT}/health/liveliness" 120

    log "verifying postgres access"
    verify_postgres_access

    start_config_service
    start_access_control
    start_file_service
    start_workflow_compiling_service
    start_texera_web
    start_computing_unit_master
    start_computing_unit_managing
    start_agent_service
    start_rtc_service
    start_frontend

    log "local dev stack is running"
    log "  postgres: postgresql://texera:password@localhost:${POSTGRES_PORT}/texera_db"
    log "  minio:    http://localhost:${MINIO_PORT} (texera_minio / password)"
    log "  lakefs:   http://localhost:${LAKEFS_PORT} (AKIAIOSFOLKFSSAMPLES / wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY)"
    log "  litellm:  http://localhost:${LITELLM_PORT}"
    log "  config:   http://localhost:${CONFIG_SERVICE_PORT} (log: $CONFIG_SERVICE_LOG_FILE)"
    log "  access:   http://localhost:${ACCESS_CONTROL_PORT} (log: $ACCESS_CONTROL_LOG_FILE)"
    log "  file:     http://localhost:${FILE_SERVICE_PORT} (log: $FILE_SERVICE_LOG_FILE)"
    log "  compile:  http://localhost:${WORKFLOW_COMPILING_SERVICE_PORT} (log: $WORKFLOW_COMPILING_SERVICE_LOG_FILE)"
    log "  compute:  http://localhost:${COMPUTING_UNIT_MANAGING_PORT} (log: $COMPUTING_UNIT_MANAGING_LOG_FILE)"
    log "  texera:   http://localhost:${TEXERA_WEB_PORT} (log: $TEXERA_WEB_LOG_FILE)"
    log "  master:   http://localhost:${COMPUTING_UNIT_MASTER_PORT} (log: $COMPUTING_UNIT_MASTER_LOG_FILE)"
    log "  agent:    http://localhost:${AGENT_SERVICE_PORT} (log: $AGENT_SERVICE_LOG_FILE)"
    log "  rtc:      ws://localhost:${RTC_PORT} (log: $RTC_LOG_FILE)"
    log "  frontend: http://localhost:${FRONTEND_PORT} (log: $FRONTEND_LOG_FILE)"
}

stop_stack() {
    require_command docker
    if [[ ! -f "$COMPOSE_FILE" ]]; then
        err "compose file not found: $COMPOSE_FILE"
        exit 1
    fi

    stop_frontend
    stop_rtc_service
    stop_agent_service
    stop_computing_unit_managing
    stop_computing_unit_master
    stop_texera_web
    stop_workflow_compiling_service
    stop_file_service
    stop_access_control
    stop_config_service
    compose down
    log "local dev stack stopped"
}

case "${1:-}" in
    start)
        shift
        if (( $# > 0 )); then
            usage
            exit 2
        fi
        start_stack
        ;;
    stop)
        shift
        if (( $# > 0 )); then
            usage
            exit 2
        fi
        stop_stack
        ;;
    *)
        usage
        exit 2
        ;;
esac
