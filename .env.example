# dataflow-agent — root environment file.
#
#   cp .env.example .env       # then fill in the keys you have
#
# Read by BOTH launch paths, so everything can be run from the repo root:
#   bin/local-dev.sh   — the full Texera stack (JVMs + frontend + agent-service
#                        + docker infra incl. the LiteLLM proxy)
#   bin/bench.sh       — the KramaBench / LongDS benchmark driver
#
# Values already exported in your shell win over this file.

# ── LLM provider keys ────────────────────────────────────────────────────
# Handed to the LiteLLM container (bin/single-node/litellm-config.yaml maps
# models to these). You only need the keys for the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LiteLLM proxy ────────────────────────────────────────────────────────
# Default: the compose-managed LiteLLM at localhost:4000 with the local dev
# master key. To use an external OpenAI-compatible gateway instead (e.g. a
# hosted LiteLLM), point BASE_URL at it and set its master key — no other
# change needed; the access-control-service proxies all model calls there.
#LITELLM_BASE_URL=http://localhost:4000
#LITELLM_MASTER_KEY=sk-texera-internal-do-not-share

# ── Benchmarks ───────────────────────────────────────────────────────────
# KramaBench scoring calls gpt-4o-mini via the OpenAI API directly, using
# OPENAI_API_KEY above (a dummy key silently zeroes the paraphrase metrics).
#
# LongDS judge: defaults to the local LiteLLM proxy. Override to use another
# OpenAI-compatible endpoint for judging.
#JUDGE_BASE_URL=http://localhost:4000/v1
#JUDGE_API_KEY=sk-texera-internal-do-not-share

# ── Benchmark data downloads (optional) ──────────────────────────────────
# Both datasets are PUBLIC and download anonymously; set these only if you
# hit rate limits or switch to a gated/private dataset.
#
# Hugging Face (LongDS tasks come from hf.co/datasets/zjunlp/LongDS):
#HF_TOKEN=
#
# Kaggle (wildfire's WeatherEvents csv comes from kaggle sobhanmoosavi/
# us-weather-events via kagglehub; ~/.kaggle/kaggle.json also works):
#KAGGLE_USERNAME=
#KAGGLE_KEY=

# ── Misc overrides (rarely needed) ───────────────────────────────────────
# Python interpreter for the engine's UDF workers (defaults to repo .venv).
#UDF_PYTHON_PATH=
# Pin the host LAN IP if autodetection picks the wrong interface.
#HOST_LAN_IP=
