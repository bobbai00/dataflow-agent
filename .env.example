# dataflow-agent — root environment file.
#
#   cp .env.example .env       # then fill in the keys you have
#
# Read by BOTH launch paths, so everything can be run from the repo root:
#   bin/local-dev.sh   — the full Texera stack (JVMs + frontend + agent-service
#                        + docker infra incl. the LiteLLM proxy)
#   bin/bench.sh       — the KramaBench benchmark driver
#
# Values already exported in your shell win over this file.

# ── LLM provider keys ────────────────────────────────────────────────────
# Handed to the LiteLLM container (bin/single-node/litellm-config.yaml maps
# models to these). You only need the keys for the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Copilot gate (REQUIRED) ──────────────────────────────────────────────
# gui.conf ships `copilot-enabled = false`. The native JVM services read this
# file (bin/local-dev/main.sh), but bin/single-node/.env is handed only to
# docker compose — so without this line access-control-service answers every
# /api/chat/* with 403 {"error": "Copilot feature is disabled"} and every agent
# run dies before its first tool call.
GUI_WORKFLOW_WORKSPACE_COPILOT_ENABLED=true

# ── LiteLLM proxy ────────────────────────────────────────────────────────
# Default: the compose-managed LiteLLM at localhost:4000 with the local dev
# master key (the value in bin/single-node/.env). MASTER_KEY is left ACTIVE
# because callers that reach the proxy directly rather than through
# access-control-service — such as KramaBench's CodeAgentSystem — authenticate
# with it; sending "dummy"/"sk-noauth" makes the proxy look for a
# virtual key in a database it does not have and answer 400 `no_db_connection`.
# To use an external OpenAI-compatible gateway instead (e.g. a hosted LiteLLM),
# point BASE_URL at it and set its master key — no other change needed.
#LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-texera-internal-do-not-share

# ── Benchmarks ───────────────────────────────────────────────────────────
# KramaBench scoring calls gpt-4o-mini via the OpenAI API directly, using
# OPENAI_API_KEY above (a dummy key silently zeroes the paraphrase metrics).

# ── Benchmark data downloads (optional) ──────────────────────────────────
# The dataset is PUBLIC and downloads anonymously; set these only if you
# hit rate limits or switch to a gated/private dataset.
#
# Kaggle (wildfire's WeatherEvents csv comes from kaggle sobhanmoosavi/
# us-weather-events via kagglehub; ~/.kaggle/kaggle.json also works):
#KAGGLE_USERNAME=
#KAGGLE_KEY=

# ── Misc overrides (rarely needed) ───────────────────────────────────────
# Python interpreter for the engine's UDF workers (defaults to repo .venv).
#UDF_PYTHON_PATH=
# Pin the host LAN IP if autodetection picks the wrong interface.
#HOST_LAN_IP=
