# The benchmark harness's command line: picks the interpreter and PYTHONPATH each command needs.
#   bench test     the offline tests, on the KramaBench venv and on the root .venv
set -euo pipefail
B=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$B/.." && pwd)
KB_PY=$B/Kramabench/.venv/bin/python
ROOT_PY=$REPO/.venv/bin/python

usage() { sed -n '14,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

cmd_test() {
  # The judge key is invalid in tests: a judge-cache miss fails a test instead of paying for a call.
  local status=0
  echo "== KramaBench venv ($KB_PY)"
  (cd "$B" && OPENAI_API_KEY=invalid-test-key PYTHONPATH="$B/src:$B/Kramabench" "$KB_PY" -m pytest -q "$@") || status=1
  echo "== root .venv ($ROOT_PY)"
  (cd "$B" && OPENAI_API_KEY=invalid-test-key PYTHONPATH="$B/src" "$ROOT_PY" -m pytest -q "$@") || status=1
  return $status
}

case "${1:-}" in
  test) shift; cmd_test "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1" >&2; usage 2 ;;
esac
